{
	"$schema": "https://getcomposer.org/schema.json",
	"name": "fatalus/feather",
	"description": "A modular, minimalist PHP microframework",
	"keywords": ["php", "package", "framework"],
	"license": "MIT",
	"type": "library",
	"version": "1.0-RC1",
	"minimum-stability": "dev",
	"authors": [
		{
			"name": "fatalus",
			"homepage": "https://fatalus.dev"
		}
	],
	"autoload": {
		"psr-4": {
			"Feather\\": "src/",
			"Tests\\": "tests/"
		}
	},
	"require": {
		"php": ">=8.3"
	},
	"require-dev": {
		"pestphp/pest": "5.x-dev"
	},
	"config": {
		"allow-plugins": {
			"pestphp/pest-plugin": true
		}
	}
}
